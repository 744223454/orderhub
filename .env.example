# 服务监听端口
PORT=8888

# PostgreSQL 连接信息
DATABASE_URL="host=localhost port=5433 user=myapp password=myapp123 dbname=myapp sslmode=disable"

# JWT 签名密钥（必填，缺失时服务拒绝启动）。
# 建议至少 32 字节随机串，可用 `openssl rand -base64 48` 生成。
JWT_SECRET=

# JWT 有效期（可选，默认 24h，支持 Go duration 格式，如 2h、720h）
JWT_EXPIRE=24h

# 企业微信扫码登录（可选能力）。四项**要么全填、要么全不填**：
#   全不填 → 不注册相关接口，服务照常启动；
#   只填一部分 → 服务拒绝启动（半套配置只会产出难定位的 500）。
# 取值位置：企微管理后台 → 应用管理 → 自建应用 → 详情页。
WECOM_CORP_ID=
WECOM_AGENT_ID=
# 应用凭证密钥。属敏感信息，只放本文件（.env 已在 .gitignore），不要提交、不要写日志。
WECOM_SECRET=
# 前端站点地址，用于拼装授权回调地址。**域名（含端口）必须与企微后台
# 「企业微信授权登录 → 授权回调域」逐字一致**，例如 http://dev.orderhub.local:3000
# 注意别与「网页授权及JS-SDK → 可信域名」混淆，两者是两套独立配置。
WECOM_WEB_BASE_URL=
