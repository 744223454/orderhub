    "definitions": {
        "internal_order.Order": {
            "type": "object",
            "properties": {
                "amount": {
                    "description": "Amount 订单金额，单位为分（用整数避免浮点精度问题，前端展示时再除以 100）。",
                    "type": "integer"
                },
                "created_at": {
                    "description": "CreatedAt 创建时间。",
                    "type": "string"
                },
                "id": {
                    "description": "ID 主键，自增。",
                    "type": "integer"
                },
                "product_name": {
                    "description": "ProductName 商品名称。",
                    "type": "string"
                },
                "status": {
                    "description": "Status 订单状态。",
                    "allOf": [
                        {
                            "$ref": "#/definitions/internal_order.Status"
                        }
                    ]
                },
                "updated_at": {
                    "description": "UpdatedAt 最后更新时间。",
                    "type": "string"
                },
                "user_id": {
                    "description": "UserID 下单用户 ID。",
                    "type": "integer"
                }
            }
        },
        "internal_order.Status": {
            "type": "string",
            "enum": [
                "pending",
                "paid",
                "shipped",
                "completed",
                "refunded"
            ],
            "x-enum-varnames": [
                "StatusPending",
                "StatusPaid",
                "StatusShipped",
                "StatusCompleted",
                "StatusRefunded"
            ]
        },
        "internal_order.createOrderRequest": {
            "type": "object",
            "required": [
                "amount",
                "product_name"
            ],
            "properties": {
                "amount": {
                    "description": "Amount 订单金额，单位为分。",
                    "type": "integer"
                },
                "product_name": {
                    "description": "ProductName 商品名称。",
                    "type": "string"
                }
            }
        },
        "internal_user.Role": {
            "type": "string",
            "enum": [
                "admin",
                "user",
                "ops"
            ],
            "x-enum-varnames": [
                "RoleAdmin",
                "RoleUser",
                "RoleOps"
            ]
        },
        "internal_user.User": {
            "type": "object",
            "properties": {
                "created_at": {
                    "description": "CreatedAt 创建时间。",
                    "type": "string"
                },
                "id": {
                    "description": "ID 主键，自增。",
                    "type": "integer"
                },
                "name": {
                    "description": "Name 登录用户名，全局唯一。",
                    "type": "string"
                },
                "role": {
                    "description": "Role 用户角色。",
                    "allOf": [
                        {
                            "$ref": "#/definitions/internal_user.Role"
                        }
                    ]
                },
                "updated_at": {
                    "description": "UpdatedAt 最后更新时间。",
                    "type": "string"
                }
            }
        },
        "internal_user.loginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        },
        "internal_user.loginResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "description": "Token Bearer 访问令牌，后续请求需放入 Authorization 头。",
                    "type": "string"
                },
                "user": {
                    "description": "User 登录成功的用户信息（不含密码哈希）。",
                    "allOf": [
                        {
                            "$ref": "#/definitions/internal_user.User"
                        }
                    ]
                }
            }
        },
        "internal_user.registerRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string"
                },
                "role": {
                    "type": "string"
                },
                "username": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}